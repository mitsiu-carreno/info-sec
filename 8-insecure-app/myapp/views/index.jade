extends layout

block content
  p.buttons
    a(href="/logout") Logout

  form#search-form
    fieldset
      legend Search
      p
        label(for="email") Email:
        input#email(type="text", name="email", placeholder="' UNION SELECT 999, '<img src=x onerror=alert(document.cookie)>', 'demo' -- ", style="width:80%")
    p.buttons
      input(type="submit", value="Search")

  h1 Users list:

  pre#result

  script(src="/javascripts/users.js")
