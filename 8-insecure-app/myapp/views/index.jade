extends layout

block content
  p.buttons
    a(href="/logout") Logout

  form#search-form
    fieldset
      legend Search
      p
        label(for="email") Email:
        input#email(type="text", name="email")
    p.buttons
      input(type="submit", value="Search")

  h1 Users list:

  pre#result

  script(src="/javascripts/users.js")
