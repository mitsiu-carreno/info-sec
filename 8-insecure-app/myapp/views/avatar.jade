extends layout

block content
  h1 Upload profile picture

  form(method="post", action="/avatar", enctype="multipart/form-data")
    fieldset
      legend Profile picture

      p
        label(for="avatar") Select an image:
        input#avatar(
          type="file",
          name="avatar",
          accept="image/*",
          required
        )

      p.buttons
        input(type="submit", value="Upload")
